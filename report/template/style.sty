%6 head sep
\setlength{\headsep}{10mm}
%7 Text height
\setlength{\textheight}{230mm}
%8 Text width
\setlength{\textwidth}{\paperwidth - 1.8in - \spirale}
%9 Margin sep
\setlength{\marginparsep}{5pt}
%10 Margin notes width
\setlength{\marginparwidth}{60pt}
%11 Foot skip
\setlength{\footskip}{15mm}

