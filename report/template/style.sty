\newcommand{\confidential}{\textbf{Confidential}}

% plain style
\makeatletter

\renewcommand*{\cleardoublepage}{%
  \clearpage
  \if@twoside
    \ifodd\c@page
    \else
      \hbox{}%
      \thispagestyle{plain}% <--- This forces your header/footer on blank pages
      \newpage
      \if@twocolumn
        \hbox{}%
        \newpage
      \fi
    \fi
  \fi
}

\newif\ifIntro
\Introtrue 


\newcommand{\footersidewidth}{0.3\textwidth}
\newcommand{\footercenterwidth}{0.4\textwidth}

\newcommand{\footercenter}{%
    \ifisconfidential
        \ifisdraft
             \hrulefill \space \textbf{Confidential - Draft} \space \hrulefill
        \else
             \hrulefill \space \textbf{Confidential} \space \hrulefill
        \fi
    \else
        \ifisdraft
             \hrulefill \space \textbf{Draft} \space \hrulefill
        \else
             \hrulefill
        \fi
    \fi
}

\def\ps@plain{%
  \renewcommand\@evenhead{\footnotesize \leftmark \hrulefill \ \docTitle}%
  \renewcommand\@oddhead{\footnotesize \leftmark \hrulefill \ \docTitle}%

  \renewcommand\@evenfoot{%
    \footnotesize
    \makebox[\footersidewidth][l]{\docAuthor \space \hrulefill}%
    \makebox[\footercenterwidth][c]{\footercenter}%
    \makebox[\footersidewidth][r]{%
       \hrulefill \space \thepage \space / \ifIntro \pageref*{endoftoc}\else \pageref*{LastPage}\fi
    }%
  }%

  \renewcommand\@oddfoot{%
    \footnotesize
    \makebox[\footersidewidth][l]{\docAuthor \space \hrulefill}%
    \makebox[\footercenterwidth][c]{\footercenter}%
    \makebox[\footersidewidth][r]{%
       \hrulefill \space \thepage \space / \ifIntro \pageref*{endoftoc}\else \pageref*{LastPage}\fi
    }%
  }%
}

